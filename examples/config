# Optional settings for `machines`. Every line can be left out.

# Extra options for the ssh connections used for polling. Polling already
# uses BatchMode (never prompts) and never forwards your agent.
# ssh_options = -o IdentityAgent=none

# An SSH agent socket to check on this machine: shows how many keys it holds,
# or that it is locked or not running.
# agent_socket = ~/.ssh/agent.sock

# On the other machines: a socket where an ssh session forwards your agent,
# to see which machines you are currently logged in to with your keys.
# forwarded_agent_socket = ~/.ssh/agent/forwarded.sock

# A git repository (such as your dotfiles) to compare across machines:
# uncommitted and unpushed changes, and how far each machine is behind.
# dotfiles = ~/dotfiles
